# Central configuration for native npm commands and Docker Compose.
# Copy to .env. Do not commit .env or place secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_APP_NAME="Speckvue Finance"
APP_PORT=3000
APP_HOST=127.0.0.1
API_PORT=4000
NEXT_PUBLIC_APP_URL="http://localhost:${APP_PORT}"
NEXT_PUBLIC_API_URL="http://localhost:${API_PORT}"

# Modes are selected by npm dev/build/start or the Docker target.
DEV_NODE_ENV=development
PROD_NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Docker image and binding configuration.
NODE_IMAGE=node:24-bookworm-slim
DOCKER_IMAGE=speckvue-finance-web:local
DOCKER_HOSTNAME=0.0.0.0
DOCKER_BIND_HOST=127.0.0.1
DOCKER_UID=1001
DOCKER_GID=1001
DOCKER_HUSKY=0
DOCKER_POLLING=false
DOCKER_RESTART_POLICY=unless-stopped
DOCKER_TMP_SIZE=64m
DOCKER_NEXT_CACHE_SIZE=128m

# Readiness probe configuration (no backend/session dependency).
HEALTHCHECK_HOST=127.0.0.1
HEALTHCHECK_TIMEOUT_MS=4000
DOCKER_HEALTH_INTERVAL=30s
DOCKER_HEALTH_TIMEOUT=5s
DOCKER_HEALTH_START_PERIOD=20s
DOCKER_DEV_HEALTH_START_PERIOD=60s
DOCKER_HEALTH_RETRIES=3

# Optional local release credential; never commit its real value.
# CI supplies this through GitHub Secrets rather than a file.
# GITHUB_TOKEN=""

# Winston JSON console logs and rotating archives.
LOG_LEVEL=info
LOG_DIRECTORY=logs
LOG_FILE_ENABLED=true
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
DOCKER_LOG_DIRECTORY=/app/logs

# Redis credentials are injected at runtime, never used as image build arguments.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=replace_with_random_redis_password
REDIS_DATABASE=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_IMAGE=redis:8.10.2-alpine
REDIS_INTERNAL_PORT=6379
DOCKER_REDIS_HOST=redis
REDIS_MAX_MEMORY=128mb
DOCKER_REDIS_MEMORY=192m
DOCKER_REDIS_CPUS=0.5
REDIS_PORT=6380
REDIS_KEY_PREFIX=speckvue:web
REDIS_CACHE_TTL_SECONDS=5
API_INTERNAL_URL=http://localhost:${API_PORT}
DOCKER_API_INTERNAL_URL=http://host.docker.internal:${API_PORT}

# Optional build-time network proxies (excluded from final image configuration).
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1,db,redis

# Development compilers need more memory than compiled production servers.
DOCKER_DEV_MEMORY=2g
DOCKER_DEV_CPUS=2.0
DEV_NODE_OPTIONS=--max-old-space-size=1536
