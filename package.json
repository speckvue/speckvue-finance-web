{
  "name": "speckvue-finance-web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend foundation for Speckvue Finance",
  "homepage": "https://github.com/speckvue/speckvue-finance-web#readme",
  "bugs": {
    "url": "https://github.com/speckvue/speckvue-finance-web/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speckvue/speckvue-finance-web.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "alignui:tokens": "alignui-cli tailwind",
    "audit:dependencies": "npm audit --omit=dev",
    "prebuild": "tsx scripts/collect-licenses.ts",
    "build": "tsx scripts/run-app.ts build",
    "commit": "tsx scripts/commit.ts",
    "commitlint": "commitlint",
    "dev": "tsx scripts/run-app.ts dev",
    "docker:build": "tsx scripts/docker.ts build",
    "docker:config": "tsx scripts/docker.ts config",
    "docker:down": "tsx scripts/docker.ts down",
    "docker:prod": "tsx scripts/docker.ts prod",
    "docker:run": "tsx scripts/docker.ts run",
    "docker:smoke": "tsx scripts/docker.ts smoke",
    "docker:up": "tsx scripts/docker.ts up",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "release": "tsx scripts/release.ts",
    "release:dry-run": "tsx scripts/release.ts --dry-run --no-ci",
    "start": "tsx scripts/run-app.ts start",
    "style:check": "tsx scripts/check-source-style.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,mjs,yml}": "prettier --write"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-accordion": "1.3.0",
    "@radix-ui/react-checkbox": "1.4.0",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.0",
    "@radix-ui/react-radio-group": "1.5.0",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.0",
    "@radix-ui/react-slider": "1.6.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.0",
    "@radix-ui/react-tabs": "1.2.0",
    "@radix-ui/react-toast": "1.3.0",
    "@radix-ui/react-tooltip": "1.4.0",
    "@remixicon/react": "4.9.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.17",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "merge-refs": "2.0.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-otp-input": "3.1.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@alignui/cli": "0.0.19",
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.64.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.7",
    "dotenv-expand": "1000.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "msw": "3.0.3",
    "postcss": "8.5.29",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^22.14.0 || >=24.10.0",
    "npm": ">=10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
